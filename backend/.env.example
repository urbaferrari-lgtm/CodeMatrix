PORT=5000
NODE_ENV=development

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb://localhost:27017/codematrix

# Generate separate random 32-byte secrets for access and refresh tokens.
JWT_ACCESS_SECRET=replace-with-a-random-32-byte-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-hex-secret

# App URLs
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Gmail OAuth2 credentials
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
EMAIL_USER=

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
